{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:timothy:website:facilities-submission:v1",
  "title": "Website to Connect facilities submission v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "dataClassification",
    "sourceProduct",
    "consumerProduct",
    "submissionId",
    "idempotencyKey",
    "submittedAt",
    "request"
  ],
  "properties": {
    "contract": { "const": "website.facilities-submission.v1" },
    "dataClassification": { "const": "restricted-personal" },
    "sourceProduct": { "const": "website" },
    "consumerProduct": { "const": "connect" },
    "submissionId": { "type": "string", "pattern": "^fac_[A-Za-z0-9_-]{16,96}$" },
    "idempotencyKey": { "type": "string", "minLength": 16, "maxLength": 128 },
    "submittedAt": { "type": "string", "format": "date-time" },
    "request": { "$ref": "#/$defs/request" }
  },
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestType", "contact", "requestedWindows", "description", "consent"],
      "properties": {
        "requestType": { "enum": ["rental", "repair", "service-provider"] },
        "contact": { "$ref": "#/$defs/contact" },
        "requestedWindows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": { "$ref": "#/$defs/window" }
        },
        "spaceRef": { "type": "string", "minLength": 1, "maxLength": 128 },
        "locationNotes": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "consent": { "$ref": "#/$defs/consent" }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "email"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "phone": { "type": "string", "minLength": 7, "maxLength": 40 },
        "organization": { "type": "string", "maxLength": 160 }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startAt", "endAt"],
      "properties": {
        "startAt": { "type": "string", "format": "date-time" },
        "endAt": { "type": "string", "format": "date-time" }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["privacyAcknowledged", "contactAllowed"],
      "properties": {
        "privacyAcknowledged": { "const": true },
        "contactAllowed": { "const": true }
      }
    }
  }
}
